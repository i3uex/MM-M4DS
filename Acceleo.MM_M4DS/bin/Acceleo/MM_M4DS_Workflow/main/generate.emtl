    <ownedModuleElement xsi:type="mtl:Template" name="fileFormatting" visibility="Public">
      <body xsi:type="mtl:FileBlock" openMode="OverWrite">
        <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="import pandas as pd&#xA;import json&#xA;import h5py&#xA;import pyarrow&#xA;"/>
        <body xsi:type="mtl:LetBlock">
          <body xsi:type="mtl:IfBlock">
            <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="from sqlalchemy import create_engine&#xA;"/>
            <body xsi:type="mtl:LetBlock">
              <body xsi:type="mtl:ForBlock">
                <body xsi:type="mtl:IfBlock">
                  <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="import mysql.connector&#xA;"/>
                  <ifExpr xsi:type="ocl.ecore:OperationCallExp">
                    <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/Boolean"/>
                    <source xsi:type="ocl.ecore:VariableExp" name="type" referredVariable="/0/fileFormatting/%/%.1/%/%.1/%/type">
                      <eType xsi:type="ecore:EEnum" href="https://www.example.org/environment#//DBTYPE"/>
                    </source>
                    <argument xsi:type="ocl.ecore:EnumLiteralExp">
                      <eType xsi:type="ecore:EEnum" href="https://www.example.org/environment#//DBTYPE"/>
                      <referredEnumLiteral xsi:type="ecore:EEnumLiteral" href="https://www.example.org/environment#//DBTYPE/MYSQL"/>
                    </argument>
                    <referredOperation xsi:type="ecore:EOperation" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/OclAny_Class/="/>
                  </ifExpr>
                  <elseIf>
                    <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="import psycopg2&#xA;"/>
                    <ifExpr xsi:type="ocl.ecore:OperationCallExp">
                      <eType xsi:type="ocl.ecore:PrimitiveType" href="http://www.eclipse.org/ocl/1.1.0/oclstdlib.ecore#/0/Boolean"/>
                      <source xsi:type="ocl.ecore:VariableExp" name="type" referredVariable="/0/fileFormatting/%/%.1/%/%.1/%/type">
                        <eType xsi:type="ecore:EEnum" href="https://www.example.org/environment#//DBTYPE"/>
                      </source>
                      <argument xsi:type="ocl.ecore:EnumLiteralExp">
                        <eType xsi:type="ecore:EEnum" href="https://www.example.org/environment#//DBTYPE"/>
