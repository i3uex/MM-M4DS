            <referredProperty xsi:type="ecore:EAttribute" href="https://www.example.org/environment#//Environment/path"/>
          </body>
          <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="&#xA;&#xA;RUN apt-get update &amp;&amp; \&#xA;    apt-get install -y --no-install-recommends wget git &amp;&amp; \&#xA;    rm -rf /var/lib/apt/lists/*&#xA;&#xA;RUN git clone --depth 1 --branch develop https://github.com/i3uex/MD4DSP-m2python.git .&#xA;&#xA;RUN wget https://download.java.net/java/ga/jdk11/openjdk-11_linux-x64_bin.tar.gz &amp;&amp; \&#xA;    tar -xvf openjdk-11_linux-x64_bin.tar.gz -C /usr/local &amp;&amp; \&#xA;    ln -s /usr/local/jdk-11/bin/java /usr/bin/java&#xA;&#xA;RUN pip install --no-cache-dir -r requirements.txt&#xA;RUN pip install h5py&#xA;RUN pip install pyarrow&#xA;"/>
          <body xsi:type="mtl:LetBlock">
            <body xsi:type="mtl:IfBlock">
              <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="RUN pip install sqlalchemy&#xA;"/>
              <body xsi:type="mtl:LetBlock">
                <body xsi:type="mtl:ForBlock">
                  <body xsi:type="mtl:IfBlock">
                    <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol="RUN pip install mysql-connector-python --upgrade&#xA;"/>
                    <ifExpr xsi:type="ocl.ecore:OperationCallExp">
